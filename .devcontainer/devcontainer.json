{
  "name": "ROS2 Jazzy + Gazebo Harmonic (VNC)",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "forwardPorts": [6080],
  "portsAttributes": {
    "6080": {
      "label": "noVNC (Gazebo 畫面)",
      "onAutoForward": "notify"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-iot.vscode-ros"
      ]
    }
  },
  "postCreateCommand": "echo 'source /opt/ros/jazzy/setup.bash' >> ~/.bashrc && echo 'if [ -f /workspaces/RobotAI_POC/install/setup.bash ]; then source /workspaces/RobotAI_POC/install/setup.bash; fi' >> ~/.bashrc",
  "postStartCommand": "bash /usr/local/bin/start-vnc.sh > /tmp/start-vnc.log 2>&1 &",
  "remoteUser": "root"
}
